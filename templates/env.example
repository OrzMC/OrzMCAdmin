# ===== PaperMC 运维技能环境变量模板 =====
# 复制为 ~/.hermes/.env（或项目 .env）并填入自己的值，chmod 600
# 脚本自动读取；也支持 export 环境变量方式注入

# --- 通用 ---
# 本地服务器目录（local 后端）
PAPER_DIR=~/minecraft-server
# Java 路径（默认用 PATH 中的 java；多版本共存时指定）
# PAPER_JAVA=/path/to/jdk-25/bin/java

# --- Exaroton 后端 ---
# API Key: https://exaroton.com/account 生成
EXAROTON_API_KEY=your_exaroton_api_key_here
# 服务器 ID: 服务器面板 URL 中的 13 位 ID
EXAROTON_SERVER_ID=your_server_id_here

# --- MCSManager 后端 ---
# 面板地址（含端口）
MCSM_URL=http://your-mcsm-host:23333/
# 面板 API Key（面板设置中生成）
MCSM_API_KEY=your_mcsm_api_key_here
# daemonId + instanceId：从面板实例页面 URL 获取
MCSM_DAEMON_ID=your_daemon_id_here
MCSM_INSTANCE_ID=your_instance_id_here

# ===== 说明 =====
# - MCSM apikey 是普通用户权限，只能访问自己名下的实例
# - daemonId 在 daemon 重装/迁移后会变，需重新获取
# - 禁止把真实凭据提交到 Git 仓库（.gitignore 已排除 .env）
